{
  "manifest_version": 3,
  "name": "ApplySafe",
  "version": "0.1.0",
  "description": "Check a Canadian job posting for scam phrases. Rules run on this device.",
  "action": {
    "default_title": "ApplySafe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://*.indeed.com/*",
    "https://ca.indeed.com/*",
    "https://www.indeed.ca/*",
    "https://*.indeed.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/messaging/*",
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://ca.indeed.com/*",
        "https://www.indeed.ca/*",
        "https://*.indeed.ca/*"
      ],
      "js": ["rules.js", "scan.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
